# {{.Domain}} of account {{.User}}. Written by rayxod; changes are overwritten.
<VirtualHost {{.Backend}}>
{{- template "apache-site" .}}
</VirtualHost>
{{- if .SSL}}

# The same website for the requests that came over HTTPS. Nginx sends them
# here over TLS, so Apache, PHP and the website's .htaccess see HTTPS as the
# visitor does: %{HTTPS} is on and the port 443, so a force-HTTPS rule does
# not redirect forever, and Apache's own redirects stay on https://.
<VirtualHost {{.TLSBackend}}>
    SSLEngine on
{{- template "apache-site" .}}
</VirtualHost>
{{- end}}
{{- /* The website itself, the same over HTTP and HTTPS. */ -}}
{{define "apache-site"}}
    ServerName {{.Domain}}
    ServerAlias www.{{.Domain}}
    DocumentRoot {{.DocumentRoot}}

    # No access log: Nginx in front already logs every request.
    ErrorLog {{.LogDir}}/{{.Domain}}.apache-error.log
{{- if .CustomApache}}

    # The administrator's additions for every website.
    IncludeOptional {{.CustomApache}}
{{- end}}

    # Web application firewall (ModSecurity). The audit log is per-domain, so the
    # account reads its WAF events from the log viewer; the engine state follows
    # the server-wide default unless this website overrides it. The IfModule
    # guard keeps the vhost valid on a server where the module is not loaded.
    <IfModule security2_module>
        SecAuditLog {{.ModSecAuditLog}}
{{- if .ModSecEngine}}
        SecRuleEngine {{.ModSecEngine}}
{{- end}}
    </IfModule>

{{- if .PHP}}

    DirectoryIndex index.php index.html index.htm

    # PHP runs in the account's own pool. Every pool has its own FastCGI
    # worker name, so Apache never shares a connection between two pools.
    <FilesMatch "\.({{.PHPPattern}})$">
        SetHandler "proxy:unix:{{.Socket}}|fcgi://{{.PoolName}}"
    </FilesMatch>

    # Tell the pool which account this request belongs to; the pool's guard
    # refuses a request routed here from another account. .htaccess cannot
    # change this, because Apache sets it after .htaccess has run.
    ProxyFCGISetEnvIf "true" RAYXO_POOL_OWNER "{{.User}}"
{{- else}}

    DirectoryIndex index.html index.htm

    # PHP is turned off for this website: its scripts are refused, never
    # served as text (they may hold passwords).
    <FilesMatch "\.(php[0-9]?|phtml|phar)$">
        Require all denied
    </FilesMatch>
{{- end}}
{{- if .MIMETypes}}

    # Content types the website sets itself.
{{- range .MIMETypes}}
    AddType {{.Type}} .{{.Extension}}
{{- end}}
{{- end}}
{{- if .ErrorPages}}

    # The website's own error pages.
{{- range .ErrorPages}}
    ErrorDocument {{.Status}} {{.URI}}
{{- end}}
{{- end}}
{{- range .Protected}}

    # {{.Path}} asks for a username and password here too, so a request
    # that reaches Apache without passing Nginx still needs one.
    <Directory "{{.Directory}}">
        AuthType Basic
        AuthName "{{.Realm}}"
        AuthUserFile {{.File}}
        Require valid-user
    </Directory>
{{- end}}
{{- if .CGI}}

    # CGI scripts in cgi-bin run as the account through suEXEC, which also
    # refuses scripts that others could change.
    SuexecUserGroup {{.User}} {{.User}}
    <Directory "{{.DocumentRoot}}/cgi-bin">
        Options +ExecCGI
        SetHandler cgi-script
    </Directory>
{{- end}}
{{- if and .ErrorPages .Protected}}

    # The error pages show without a login, also that of a wrong login.
    <Directory "{{.DocumentRoot}}/.errors">
        Require all granted
    </Directory>
{{- end}}
{{- end}}
